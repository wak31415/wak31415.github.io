---
// Standalone Gaussian-splat renderer, embedded as an iframe by src/components/Portrait.astro.
// Scripts are is:inline so Astro leaves the import map and vendored modules in public/assets/vendor/ untouched.
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>William Koch — 3D Gaussian portrait</title>
  <style is:inline>
    html, body, #viewer { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    html, body { background: transparent; }
    #viewer { touch-action: pan-y; }
    canvas { display: block; width: 100%; height: 100%; background: transparent !important; }
    .fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; box-sizing: border-box; opacity: 0; transform: scale(.88); transition: opacity 240ms ease; }
    .failed .fallback { opacity: 1; }
  </style>
  <script is:inline type="importmap">
    {"imports":{"three":"/assets/vendor/three-r180.module.min.js","three/addons/":"/assets/vendor/three-addons/","@sparkjsdev/spark":"/assets/vendor/spark-2.2.0.module.js"}}
  </script>
</head>
<body>
  <img class="fallback" src="/assets/avatar/william-user-mesh-avatar.webp" alt="">
  <div id="viewer" aria-hidden="true"></div>
  <script is:inline type="module">
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    try {
      const THREE = await import("three");
      const { SparkRenderer, SplatMesh, dyno } = await import("@sparkjsdev/spark");
      const surface = document.querySelector("#viewer");
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(55, 1, .01, 100);
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false, powerPreference: "high-performance" });
      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
      surface.appendChild(renderer.domElement);

      const resize = () => {
        const width = Math.max(1, surface.clientWidth);
        const height = Math.max(1, surface.clientHeight);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height, false);
      };
      addEventListener("resize", resize, { passive: true });
      resize();

      const spark = new SparkRenderer({
        renderer,
        focalAdjustment: 2,
        maxStdDev: Math.sqrt(6)
      });
      scene.add(spark);
      const portrait = new SplatMesh({ url: "/assets/avatar/william-user-mesh-avatar-3dgs.splat" });
      portrait.scale.setScalar(.88);
      scene.add(portrait);
      await portrait.loaded;

      const formationProgress = dyno.dynoFloat(0);
      const disintegrateIntensity = dyno.dynoFloat(.21);
      portrait.objectModifier = dyno.dynoBlock(
        { gsplat: dyno.Gsplat },
        { gsplat: dyno.Gsplat },
        ({ gsplat }) => {
          const disintegrate = new dyno.Dyno({
            inTypes: { gsplat: dyno.Gsplat, t: "float", intensity: "float" },
            outTypes: { gsplat: dyno.Gsplat },
            globals: () => [dyno.unindent(/* glsl */ `
              vec3 hash(vec3 p) {
                return fract(sin(p * 123.456) * 123.456);
              }
              mat2 rot(float a) {
                float s = sin(a), c = cos(a);
                return mat2(c, -s, s, c);
              }
              vec4 disintegrateEffect(vec3 pos, float reveal, float intensity) {
                vec3 scattered = pos + (hash(pos) * 2.0 - 1.0) * intensity;
                float formed = smoothstep(0.0, 1.0, reveal);
                float scatteredAmount = 1.0 - formed;
                scattered.xz *= rot(scatteredAmount * (2.0 + pos.y * 2.0));
                return vec4(mix(scattered, pos, formed), formed);
              }
            `)],
            statements: ({ inputs, outputs }) => dyno.unindentLines(/* glsl */ `
              ${outputs.gsplat} = ${inputs.gsplat};
              vec4 effect = disintegrateEffect(${inputs.gsplat}.center, ${inputs.t}, ${inputs.intensity});
              ${outputs.gsplat}.center = effect.xyz;
              ${outputs.gsplat}.scales = mix(vec3(.008), ${inputs.gsplat}.scales, effect.w);
              ${outputs.gsplat}.rgba.a = mix(${inputs.gsplat}.rgba.a * .72, ${inputs.gsplat}.rgba.a, effect.w);
            `)
          });
          return { gsplat: disintegrate.apply({
            gsplat,
            t: formationProgress,
            intensity: disintegrateIntensity
          }).gsplat };
        }
      );
      portrait.updateGenerator();

      const orbitRadius = 1.65;
      const target = { yaw: 0, pitch: 0 };
      const current = { yaw: 0, pitch: 0 };
      const setPointer = (x, y) => {
        target.yaw = Math.max(-1, Math.min(1, x)) * .11;
        target.pitch = -Math.max(-1, Math.min(1, y)) * .065;
      };
      addEventListener("message", (event) => {
        if (event.origin !== location.origin || event.source !== parent || event.data?.type !== "avatar-pointer") return;
        setPointer(Number(event.data.x) || 0, Number(event.data.y) || 0);
      });
      addEventListener("pointermove", (event) => {
        const bounds = surface.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        setPointer(((event.clientX - bounds.left) / bounds.width) * 2 - 1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1);
      }, { passive: true });
      document.documentElement.addEventListener("pointerleave", () => setPointer(0, 0));

      const cameraEase = reduceMotion ? 1 : .075;
      const formationDelay = 900;
      const formationDuration = 1800;
      const formationStart = performance.now() + formationDelay;
      document.documentElement.dataset.formation = "0.000";
      renderer.setAnimationLoop((time) => {
        current.yaw += (target.yaw - current.yaw) * cameraEase;
        current.pitch += (target.pitch - current.pitch) * cameraEase;
        const pitchScale = Math.cos(current.pitch);
        camera.position.set(
          orbitRadius * Math.sin(current.yaw) * pitchScale,
          orbitRadius * Math.sin(current.pitch),
          orbitRadius * Math.cos(current.yaw) * pitchScale
        );
        camera.lookAt(0, .08, 0);
        if (formationProgress.value < 1) {
          const linearProgress = Math.max(0, Math.min(1, (performance.now() - formationStart) / formationDuration));
          formationProgress.value = linearProgress * linearProgress * (3 - 2 * linearProgress);
          document.documentElement.dataset.formation = formationProgress.value.toFixed(3);
          portrait.updateVersion();
        }
        renderer.render(scene, camera);
      });

      document.body.classList.add("ready");
      window.parent.postMessage("avatar-ready", location.origin);
    } catch (error) {
      console.error(error);
      document.querySelector("#viewer").hidden = true;
      document.body.classList.add("failed");
    }
  </script>
</body>
</html>
