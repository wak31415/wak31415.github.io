---
import Base from "../../layouts/Base.astro";
import LinkPills from "../../components/LinkPills.astro";
import { formatMonth, getTalks } from "../../lib/content";

const talks = await getTalks();
---

<Base title="Talks" description="Talks and presentations by William Koch.">
  <header class="page-intro">
    <div>
      <p class="eyebrow">Presentations</p>
      <h1>Talks</h1>
      <p>Invited talks, conference presentations, and teaching material.</p>
    </div>
  </header>
  {
    talks.length > 0 ? (
      <section class="section-block talks-list" aria-label="Talks">
        {talks.map((talk) => (
          <article class="talk-entry" id={talk.id}>
            <p class="meta">{formatMonth(talk.data.date)}</p>
            <div>
              <h2>{talk.data.title}</h2>
              <p class="talk-venue">{[talk.data.venue, talk.data.location].filter(Boolean).join(" · ")}</p>
              <LinkPills links={talk.data.links} />
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="section-block talks-empty">
        <p>Talks will be listed here.</p>
      </section>
    )
  }
</Base>
